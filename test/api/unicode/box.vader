Execute ( spacevim api: unicode#tree ):
  let box = spacevim#api#import('unicode#box')
  if &encoding ==# 'utf-8'
    AssertEqual box.drawing_box([1,2,3] , 1, 3, 5),
      \ [
      \ '╭─────┬─────┬─────╮',
      \ '│  1  │  2  │  3  │',
      \ '╰─────┴─────┴─────╯'
      \ ]
  else
    AssertEqual box.drawing_box([1,2,3] , 1, 3, 5),
      \ ['*-----*-----*-----*',
      \ '|  1  |  2  |  3  |',
      \ '*-----*-----*-----*']
  end

