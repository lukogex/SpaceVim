Execute (Test web#http api):
    let g:test_api_web_html = spacevim#api#import('web#html')
    let g:test_api_web_html_paser = g:test_api_web_html.parseURL('https://github.com/lukogex/spacevim')
    AssertEqual g:test_api_web_html_paser.child[1].find('title').child[0], 'GitHub - lukogex/spacevim: SpaceVim is a modular configuration of Neovim. · GitHub'
