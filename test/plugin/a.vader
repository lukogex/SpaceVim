Execute ( spacevim plugin: a.vim ):
  call spacevim#plugins#a#set_config_name(getcwd(), '.spacevim.d/.project_alt.toml')
  let root = spacevim#plugins#a#getConfigPath()
  AssertEqual spacevim#plugins#a#get_alt('autoload/spacevim/api/cmdlinemenu.vim', root, 1), 'test/api/cmdlinemenu.vader'
  AssertEqual spacevim#plugins#a#get_alt('autoload/spacevim/layers/lsp.vim', root, 1), 'docs/layers/language-server-protocol.md'
  unlet root
