Execute ( spacevim plugin: quickfix ):
  let qflist = [
  \ {    
    \ 'abbr' : 'test-abbr',
    \ 'filename' : '~/test/Foo.java',
    \ 'lnum' : 1,
    \ 'col' : 1,
    \ 'type' : 'E',
    \ 'text' : 'test-text'
  \ }
  \ ]
  call spacevim#plugins#quickfix#setqflist(qflist)
  AssertEqual spacevim#plugins#quickfix#getqflist()[0].abbr, 'test-abbr'
