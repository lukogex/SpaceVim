Execute ( spacevim lua layer: lang#java ):
  if !has('nvim-0.7.2')
    Log 'skip lua test'
    finish
  endif
  let cmp = spacevim#api#import('vim#compatible')
  lua require('spacevim.layers.lang.java').set_variable({format_on_save = false})
  lua format_on_save = require('spacevim.layers.lang.java').get_variable().format_on_save
  AssertEqual cmp.luaeval('format_on_save'), v:false
