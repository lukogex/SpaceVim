Execute ( spacevim lua api: data#toml ):
  if !has('nvim-0.7.2')
    Log 'skip lua test'
    finish
  endif
  let cmp = spacevim#api#import('vim#compatible')
  lua sp_toml = require('spacevim.api').import('data.toml')
  AssertEqual cmp.luaeval("sp_toml.parse_file('config/init.toml').options.colorscheme"), 'gruvbox'
