Execute ( spacevim lua api: vim.keys.t(str) ):
  if !has('nvim-0.7.2')
    Log 'skip lua test'
    finish
  endif
  let cmp = spacevim#api#import('vim#compatible')
  lua spacevim_keys = require('spacevim.api').import('vim.keys')
  AssertEqual cmp.luaeval('spacevim_keys.t("<Right>")'), "\<Right>"
